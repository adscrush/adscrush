{
  "name": "@adscrush/server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/routers/_app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@adscrush/auth": "workspace:*",
    "@adscrush/db": "workspace:*",
    "@adscrush/env": "workspace:*",
    "@adscrush/shared": "workspace:*",
    "@bunny.net/storage-sdk": "^0.3.1",
    "@elysiajs/cors": "^1.4.1",
    "@maxmind/geoip2-node": "^4.2.0",
    "@trpc/server": "^11.0.0-rc.825",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "ioredis": "^5.5.0",
    "ipaddr.js": "^2.4.0",
    "lru-cache": "^11.0.0",
    "mmdb-lib": "^2.2.1",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@adscrush/typescript-config": "workspace:*",
    "@types/bun": "^1.3.11",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
