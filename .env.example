# ─── AdsCrush Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# 💡 Required vars are marked with [REQUIRED]
# 💡 Optional vars show their default value

# ─── Shared (required by all apps) ───────────────────────────────────────────
NODE_ENV=development                          # development | production | test
DATABASE_URL=postgres://adscrush:adscrush@localhost:6432/adscrush  # [REQUIRED]
REDIS_URL=redis://localhost:6379              # Default: redis://localhost:6379
BETTER_AUTH_SECRET=change-me-to-a-random-secret  # [REQUIRED]

# ─── Server (apps/server) ───────────────────────────────────────────────────
PORT=4000                                     # Default: 4000
LOG_LEVEL=info                                # fatal | error | warn | info | debug | trace | silent
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
FRONTEND_APP_URL=http://localhost:3000

# Social Login (Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id        # [REQUIRED]
GOOGLE_CLIENT_SECRET=your-google-client-secret # [REQUIRED]

# Turnstile captcha (Cloudflare) — optional; verification skipped when unset
TURNSTILE_SECRET_KEY=                          # Optional — Cloudflare Turnstile secret key

# SMTP
SMTP_HOST=smtp.example.com                    # [REQUIRED]
SMTP_PORT=465                                 # Default: 465
SMTP_USER=your-smtp-user                      # [REQUIRED]
SMTP_PASS=your-smtp-password                  # [REQUIRED]
SMTP_FROM=noreply@example.com                 # [REQUIRED]

# Tracking
TRACKING_APP_URL=http://localhost:3002

# Bunny CDN & Storage (for media uploads)
BUNNY_STORAGE_REGION=de
BUNNY_STORAGE_ZONE=merlin-02
BUNNY_STORAGE_API_KEY=your-bunny-api-key      # [REQUIRED]
BUNNY_CDN_URL=https://merlin-02.b-cdn.net

# PII Encryption (optional — used by tracking & server)
PII_MASTER_KEY=                               # Optional
PII_PEPPER=                                   # Optional

# Tracking-specific
TRACKING_PORT=3002                            # Default: 3002
GEOIP_ASN_DB_PATH=/var/lib/geoip/GeoLite2-ASN.mmdb

# ─── Web (apps/web — Next.js) ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TRPC_API_URL=http://localhost:4000/trpc
NEXT_PUBLIC_TRACKING_DOMAIN=http://localhost:3002
NEXT_PUBLIC_BUNNY_CDN_URL=https://merlin-02.b-cdn.net
NEXT_PUBLIC_TURNSTILE_SITE_KEY=               # Optional — Cloudflare Turnstile site key (client widget)

# ─── Permissions Cache ──────────────────────────────────────────────────────
PERMISSION_CACHE_TTL_SECONDS=300              # Default: 300 (5 minutes)

# ─── Tracking Domain (used by web-sdk / tracking) ───────────────────────────
TRACKING_DOMAIN=http://localhost:3002
